# LLM and AI Configuration
OPENAI_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=your-openrouter-key-here
LLM_PROVIDER=openrouter
LLM_MODEL=moonshotai/kimi-k2.5:free
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Data & Vector Storage
VECTORSTORE_DIR=./data/vectorstore
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
CHROMA_PERSIST_DIRECTORY=./data/vectorstore

# Database (PostgreSQL or local SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cruvels_legal

# Authentication & Security
AUTH_SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
